; driver.inf — installation metadata for CS2Radar kernel driver
;
; Windows uses INF files to associate a .sys file with hardware/device IDs.
; For a software-only driver (no real hardware) this is minimal.
; Required for signing and proper sc create integration.

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ManufacturerName%
DriverVer   = 05/03/2026,1.0.0.0
CatalogFile = driver.cat          ; generated by signtool during signing

[DestinationDirs]
DefaultDestDir = 12               ; %windir%\System32\drivers\

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
driver.sys = 1

[DefaultInstall.NTamd64]
CopyFiles = DriverCopyFiles

[DriverCopyFiles]
driver.sys

[DefaultInstall.NTamd64.Services]
AddService = CS2Radar, 0x00000002, CS2Radar_Service

[CS2Radar_Service]
DisplayName    = %ServiceName%
ServiceType    = 1                ; SERVICE_KERNEL_DRIVER
StartType      = 3                ; SERVICE_DEMAND_START (manual, via sc start)
ErrorControl   = 1                ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\driver.sys  ; %12% = \System32\drivers

[Strings]
ManufacturerName = "CS2Radar Dev"
DiskName         = "CS2Radar Driver Disk"
ServiceName      = "CS2 Radar Kernel Memory Reader"
